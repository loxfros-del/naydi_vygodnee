# Telegram Bot Token — получить у @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID админов через запятую — получить у @userinfobot
ADMIN_IDS=123456789,987654321
# Network / proxy
PROXY_URL=
USE_PROXY=false
PROXY_FOR_HTTP=true
PROXY_FOR_BROWSER=true

# Browser provider
BROWSER_PROVIDER=local
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Fetch policy
FETCH_TIMEOUT_SECONDS=20
FETCH_RETRIES=2
DOMAIN_RATE_LIMIT_SECONDS=2
ENABLE_BROWSER_FALLBACK=true

# SearchApi Google Shopping (optional)
SEARCHAPI_ENABLED=false
SEARCHAPI_API_KEY=
SEARCHAPI_GL=ru
SEARCHAPI_HL=ru
SEARCHAPI_LOCATION=Russia
SEARCHAPI_MAX_RESULTS=5
SEARCHAPI_TIMEOUT_SECONDS=15
