+            keep_for_admin=not hard,
+            score_cap=40 if hard else 60,
+        )
+
+    if product_level == "weak" and status in {"VERIFIED_GOOD", "VERIFIED_OK"}:
+        return FinalQualityGateResult(
+            status="NEED_MANUAL_CHECK",
+            reason=getattr(candidate, "why_not_verified_good", "") or DIRECT_QUALITY_MANUAL_RISK,
+            product_quality_level="weak",
+            keep_for_admin=True,
