          "чехол",
          "стекло",
          "подарок",
          "муляж",
          "копия",
          "реплика"
        ],
        "bad_if_price_below": 40000,
        "manual_without_verified_price_score_max": 60
      },
      "known_bad_examples": [
        {
          "title_contains": [
            "iPhone 16 Pro Max"
          ],
          "bad_if_saved_as_match": true,
          "why": "Pro Max это другая модель"
        },
        {
          "title_contains": [
            "чехол",
            "стекло",
            "в подарок"
          ],
          "bad_if_saved_as_match": true,
          "why": "аксессуар/комплектный мусор не должен быть кандидатом телефона"
        },
        {
          "title_contains": [
            "iPhone 16 Pro",
            "256"
          ],
          "source": "avito_search",
          "expected_manual_risks": [
            "проверить продавца",
            "проверить город",
            "проверить состояние",
            "проверить отзывы"
          ],
          "why": "Avito можно сохранять только как manual/OK, не как полностью проверенный GOOD"
        }
      ],
      "manual_good_items_to_fill": [
        {
          "url": "https://apple-market.ru/smartfon-apple-iphone-16-pro-256-gb-dual-sim-esim-desert-titanium/",
          "expected_title_contains_all": [
            "iPhone",
            "16",
            "Pro",
            "256"
          ],
          "expected_title_not_contains": [
            "Max",
            "чехол",
            "стекло"
          ],
          "expected_price_min": 40000,
          "expected_price_max": 200000,
          "note": "вставь вручную нормальную карточку iPhone 16 Pro 256"
        }
      ]
    },
