{
  "schema_version": 1,
  "goal": "Golden dataset для проверки качества выдачи. Проверяем не абстрактный GOOD/OK, а что бот не врёт цену, не тащит мусор в топ и не даёт manual/blocked score 100+.",
  "global_assertions": {
    "price_must_not_be_budget_without_currency": true,
    "manual_without_verified_price_score_max": 60,
    "price_missing_score_max": 45,
    "blocked_manual_score_max": 60,
    "low_price_suspect_cannot_be_top1": true,
    "candidate_without_price_must_not_claim_exact_price": true,
    "blocked_or_manual_must_not_be_verified_good": true
  },
  "queries": [
    {
      "id": "headphones_10k",
      "query": "Нужны наушники до 10к",
      "category": "headphones",
      "budget": 10000,
      "intent": "нужны нормальные наушники, не самый дешёвый мусор",
      "expected": {
        "min_saved_for_admin": 1,
        "preferred_price_min": 1000,
        "preferred_price_max": 10000,
        "bad_if_top_price_below": 800,
        "bad_if_price_equals_budget": true,
        "bad_markers_as_price": [
          "до 10к",
          "до 10000",
          "10000 mAh",
          "10000 Гц",
          "10000 Hz",
          "10000 отзывов"
        ],
        "manual_without_verified_price_score_max": 60
      },
      "known_bad_examples": [
        {
          "title_contains": [
            "AIR39",
            "беспроводные",
            "USB Type-C"
          ],
          "real_price_range": [
            200,
            800
          ],
          "bad_if_bot_price": 10000,
          "why": "бот взял бюджет/характеристику как цену"
        },
        {
          "title_contains": [
            "Sogood B39"
          ],
          "real_price_range": [
            300,
            800
          ],
          "bad_if_top1": true,
          "why": "дешёвый ноунейм не должен быть топом при бюджете 10к"
        },
        {
          "title_contains": [
            "YINDIAO",
            "3.5 мм"
          ],
          "real_price_range": [
            200,
            900
          ],
          "bad_if_top1": true,
          "why": "проводной дешёвый ноунейм не должен обгонять нормальные варианты"
        }
      ],
      "manual_good_items_to_fill": [
        {
          "url": "https://www.ozon.ru/product/naushniki-besprovodnye-s-mikrofonom-anker-soundcore-space-one-bezhevyy-3548206984/?utm_medium=organic&utm_source=yandex_serp_products",
          "expected_title_contains_any": [
            "JBL",
            "Soundcore",
            "Xiaomi",
            "QCY",
            "Sony",
            "Anker"
          ],
          "expected_available": true,
          "expected_price_min": 1000,
          "expected_price_max": 10000,
          "note": "вставь вручную нормальный товар из Ozon/Market/DNS/MVideo/Citilink"
        },
        {
          "url": "https://www.wildberries.ru/catalog/436506376/detail.aspx?utm_source=yandex&utm_medium=feed&utm_campaign=feed",
          "expected_title_contains_any": [
            "JBL",
            "Soundcore",
            "Xiaomi",
            "QCY",
            "Sony",
            "Anker"
          ],
          "expected_available": true,
          "expected_price_min": 1000,
          "expected_price_max": 10000,
          "note": "второй нормальный товар для сравнения"
        },
        {
          "url": " https://www.dns-shop.ru/product/b73d8cc83fdf7d9d/besprovodnye-nausniki-baseus-bowie-h1-pro-belyj-2024/?utm_source=webmaster_msk&utm_medium=cpc&utm_campaign=webmaster_msk",
          "expected_title_contains_any": [
            "JBL",
            "Soundcore",
            "Xiaomi",
            "QCY",
            "Sony",
            "Anker"
          ],
          "expected_available": true,
          "expected_price_min": 1000,
          "expected_price_max": 10000,
          "note": "третий нормальный товар для сравнения"
        },
        {
          "url": " https://www.dns-shop.ru/product/33ce9e6f65dbd0a4/nausniki-tws-technics-eah-az40m2-koricnevyj-2023/ ",
          "expected_title_contains_any": [
            "JBL",
            "Soundcore",
            "Xiaomi",
            "QCY",
            "Sony",
            "Anker"
          ],
          "expected_available": true,
          "expected_price_min": 1000,
          "expected_price_max": 10000,
          "note": "четвертый нормальный товар для сравнения"
        }
      ]
    },
    {
      "id": "iphone_16_pro_256",
      "query": "iPhone 16 Pro 256 ГБ",
      "category": "phone",
      "budget": null,
      "intent": "найти именно iPhone 16 Pro 256GB, не Pro Max, не 512GB, не аксессуар",
      "expected": {
        "min_saved_for_admin": 1,
        "must_contain_all": [
          "iPhone",
          "16",
          "Pro"
